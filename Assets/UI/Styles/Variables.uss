:root {
    /* Glassmorphism Color Palette */
    --color-bg-deep: rgba(10, 15, 25, 1);
    --color-glass-tint: rgba(255, 255, 255, 0.03);
    --color-glass-border: rgba(255, 255, 255, 0.12);
    
    /* Accents */
    --color-accent-cyan: #00F0FF;
    --color-accent-amber: #FFB000;
    --color-accent-red: #FF2A2A;
    
    /* Typography */
    --color-text-primary: #FFFFFF;
    --color-text-secondary: rgba(255, 255, 255, 0.6);
    --color-text-muted: rgba(255, 255, 255, 0.3);

    /* Spacing & Radii */
    --radius-md: 16px;
    --border-thin: 1px;
    --radius-glass: 12px;
    --spacing-xs: 4px;
    --spacing-sm: 8px;
    --spacing-md: 16px;
    --spacing-lg: 24px;
    --spacing-xl: 32px;
}

/* Base Glass Panel Class */
.glass-panel {
    position: relative;
    border-radius: var(--radius-md);
    border-width: var(--border-thin);
    border-color: var(--color-glass-border);
    background-color: var(--color-glass-tint);
    overflow: hidden; 
    padding: var(--spacing-md);
}

.glass-bg {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-image: url("project:/Assets/Images/global-background.png");
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgba(10, 15, 25, 0.8);
    filter: blur(15px);
    opacity: 0.99;
}

.text-primary {
    color: var(--color-text-primary);
    font-size: 14px;
}

.text-header {
    color: var(--color-text-primary);
    font-size: 18px;
    -unity-font-style: bold;
}

.text-accent {
    color: var(--color-accent-cyan);
}
